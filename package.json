{
  "name": "rpg-assets-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#utils/*": "./src/utils/*",
    "#server/*": "./src/server/*",
    "#web/*": "./src/web/*",
    "#components/*": "./src/web/components/*"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc -b src/web/tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/web/tsconfig.json",
    "check": "biome check .",
    "check:write": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "loading-tips": "node scripts/generate-loading-tips-journal.ts",
    "codegen": "kysely-codegen --dialect postgres --out-file src/server/db/types.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "clsx": "^2.1.1",
    "fastify": "^5.12.1",
    "hash-wasm": "^4.12.0",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
