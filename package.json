{
  "name": "rpg-assets-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc -b src/frontend/tsconfig.json && vite build",
    "start": "node src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
    "check": "biome check .",
    "check:write": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "codegen": "kysely-codegen --dialect postgres --out-file src/server/db/types.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^8.1.0",
    "clsx": "^2.1.1",
    "fastify": "^5.4.0",
    "hash-wasm": "^4.12.0",
    "kysely": "^0.28.2",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "kysely-codegen": "^0.18.1",
    "node-pg-migrate": "^7.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
